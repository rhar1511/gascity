{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ok",
    "target",
    "queue",
    "actions"
  ],
  "properties": {
    "schema_version": {
      "const": "2"
    },
    "ok": {
      "const": true
    },
    "target": {
      "type": "string"
    },
    "queue": {
      "$ref": "#/$defs/PRActionQueue"
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PRActionResult"
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "PRActionQueue": {
      "additionalProperties": false,
      "properties": {
        "availability": {
          "type": "string"
        },
        "fresh_until": {
          "format": "date-time",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/PRActionQueueItem"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "observed_at": {
          "format": "date-time",
          "type": "string"
        },
        "policy_detail": {
          "type": "string"
        },
        "policy_state": {
          "type": "string"
        },
        "policy_version": {
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/PRActionSource"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "availability",
        "policy_state",
        "policy_version",
        "observed_at",
        "fresh_until",
        "sources",
        "items"
      ],
      "type": "object"
    },
    "PRActionQueueItem": {
      "additionalProperties": false,
      "properties": {
        "action_receipts": {
          "items": {
            "$ref": "#/$defs/PRActionResult"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "actions": {
          "items": {
            "$ref": "#/$defs/PRActionOption"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "attempt_evidence": {
          "items": {
            "$ref": "#/$defs/PRActionAttemptReference"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "base_ref_name": {
          "type": "string"
        },
        "base_sha": {
          "type": "string"
        },
        "evidence_state": {
          "type": "string"
        },
        "fresh_until": {
          "format": "date-time",
          "type": "string"
        },
        "head_ref_name": {
          "type": "string"
        },
        "head_sha": {
          "type": "string"
        },
        "is_draft": {
          "type": "boolean"
        },
        "merge_state": {
          "type": "string"
        },
        "monitor": {
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "policy_version": {
          "type": "string"
        },
        "pull_request": {
          "format": "int64",
          "type": "integer"
        },
        "repo": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "work_records": {
          "items": {
            "$ref": "#/$defs/PRActionWorkRecord"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "monitor",
        "owner",
        "repo",
        "pull_request",
        "title",
        "base_ref_name",
        "head_sha",
        "base_sha",
        "merge_state",
        "is_draft",
        "policy_version",
        "observed_at",
        "fresh_until",
        "work_records",
        "evidence_state",
        "attempt_evidence",
        "action_receipts",
        "actions"
      ],
      "type": "object"
    },
    "PRActionResult": {
      "additionalProperties": false,
