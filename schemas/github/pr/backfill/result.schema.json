        "actor_key_id": {
          "type": "string"
        },
        "actor_subject": {
          "type": "string"
        },
        "attempt_id": {
          "type": "string"
        },
        "base_sha": {
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "head_sha": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "idempotency_key": {
          "type": "string"
        },
        "merge_commit_sha": {
          "type": "string"
        },
        "monitor": {
          "type": "string"
        },
        "outcome": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "policy_version": {
          "type": "string"
        },
        "pull_request": {
          "format": "int64",
          "type": "integer"
        },
        "repo": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "verified_at": {
          "format": "date-time",
          "type": "string"
        },
        "work_id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "action",
        "status",
        "idempotency_key",
        "monitor",
        "owner",
        "repo",
        "pull_request",
        "head_sha",
        "base_sha",
        "policy_version",
        "actor_key_id",
        "created_at"
      ],
      "type": "object"
    },
    "PRActionOption": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "type": "string"
        },
        "available": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "requires_human_approval": {
          "type": "boolean"
        }
      },
      "required": [
        "action",
        "available",
        "requires_human_approval",
        "reason"
      ],
      "type": "object"
    },
    "PRActionAttemptReference": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "type": "string"
        },
        "base_sha": {
          "type": "string"
        },
        "candidate_sha": {
          "type": "string"
        },
        "diff_sha256": {
          "type": "string"
        },
        "diff_source": {
          "type": "string"
        },
        "store_ref": {
          "type": "string"
        },
        "work_id": {
          "type": "string"
        },
        "working_tree_status": {
          "type": "string"
        }
      },
      "required": [
        "store_ref",
        "work_id",
        "attempt_id",
        "base_sha",
        "candidate_sha",
        "diff_sha256",
        "diff_source",
        "working_tree_status"
      ],
      "type": "object"
    },
    "PRActionWorkRecord": {
      "additionalProperties": false,
      "properties": {
        "assignee": {
          "type": "string"
        },
        "base_sha": {
          "type": "string"
        },
        "candidate_sha": {
          "type": "string"
        },
        "current_revision": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "status",
        "candidate_sha",
        "base_sha",
        "current_revision"
      ],
      "type": "object"
    },
    "PRActionSource": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "type": "string"
        },
        "monitor": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "repo": {
          "type": "string"
        },
        "rig": {
          "type": "string"
        },
        "state": {
          "type": "string"
        }
      },
      "required": [
        "monitor",
        "owner",
        "repo",
        "rig",
        "state"
      ],
      "type": "object"
    }
  }
}
