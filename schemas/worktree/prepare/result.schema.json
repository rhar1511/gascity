{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gc://schemas/worktree/prepare/result.schema.json",
  "title": "gc worktree prepare result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ok",
    "request_file",
    "request_sha256",
    "source_id",
    "selected_work_id"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "ok": {
      "const": true
    },
    "request_file": {
      "type": "string",
      "minLength": 1
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "selected_work_id": {
      "type": "string",
      "minLength": 1
    }
  }
}
