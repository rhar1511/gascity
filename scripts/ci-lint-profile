#!/usr/bin/env python3
"""Bound a lint process group and retain its status and profile availability."""
import argparse
import json
import math
import os
import resource
import select
from pathlib import Path
import signal
import subprocess
import sys
import time


def supervise(status_fd, command):
    """Hold an unreaped group leader until the operator terminates the group."""
    try:
        child = subprocess.Popen(command)
        status = {"raw_exit": child.wait()}
    except OSError as failure:
        status = {"raw_exit": 125, "error": str(failure)}
    os.write(status_fd, (json.dumps(status) + "\n").encode())
    os.close(status_fd)
    # Do not exit on command completion. Our live PID reserves the owned
    # group identity, including descendants retaining the output pipeline.
    while True:
        signal.pause()


def run(command, deadline, directory):
    started = time.monotonic()
    directory.mkdir(parents=True, exist_ok=True)
    process = None
    status_read = status_write = None
    exit_code = 124
    timed_out = started >= deadline
    cleanup = "not-launched"
    error = None
    cancellation = None

    def interrupt(signum, _frame):
        nonlocal cancellation
        cancellation = signum

    previous_signals = {signum: signal.signal(signum, interrupt)
                        for signum in (signal.SIGINT, signal.SIGTERM)}
    try:
        if not timed_out:
            status_read, status_write = os.pipe()
            # Signal handlers only record cancellation, so interruption during
            # Popen cannot discard the handle to a newly launched group.
            process = subprocess.Popen(
                [sys.executable, str(Path(__file__).resolve()), "--supervise",
                 str(status_write), *command],
                start_new_session=True, pass_fds=(status_write,),
            )
            os.close(status_write)
            status_write = None
            message = b""
            while True:
                if cancellation is not None:
                    exit_code = 128 + cancellation
                    break
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    timed_out = True
                    exit_code = 124
                    break
                ready, _, _ = select.select([status_read], [], [], min(remaining, .25))
                if not ready:
                    continue
                chunk = os.read(status_read, 4096)
                if not chunk:
                    error = "group supervisor exited without a command verdict"
                    exit_code = 125
                    break
                message += chunk
                if b"\n" in message:
                    status = json.loads(message)
                    raw_exit = status["raw_exit"]
                    exit_code = raw_exit if raw_exit >= 0 else 128 - raw_exit
                    error = status.get("error")
                    break
    except OSError as failure:
        error = str(failure)
        exit_code = 125
    finally:
        if process is not None:
            # Never poll/wait the leader before signaling: its reserved PID
            # prevents reuse of this group identity, even if it crashed.
            try:
                try:
                    os.killpg(process.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                process.wait(timeout=10)
                cleanup = "group-killed-leader-reaped"
            except (OSError, subprocess.TimeoutExpired) as failure:
                error = f"owned cleanup unconfirmed: {failure}"
                exit_code = 125
                cleanup = "unknown"
        for fd in (status_read, status_write):
            if fd is not None:
                os.close(fd)
        for signum, handler in previous_signals.items():
            signal.signal(signum, handler)
        profiles = {}
        for name in ("cpu.pprof", "mem.pprof"):
            path = directory / name
            try:
                profiles[name] = {"bytes": path.stat().st_size}
            except OSError as failure:
                profiles[name] = {"bytes": 0, "error": str(failure)}
        profiles_nonempty = all(item["bytes"] > 0 for item in profiles.values())
        if exit_code == 0 and not profiles_nonempty:
            error = "successful lint omitted CPU or memory profile"
            exit_code = 125
        receipt = {
            "exit_code": exit_code, "timed_out": timed_out,
            "launched": process is not None, "cleanup": cleanup,
            "elapsed_seconds": time.monotonic() - started,
            "deadline": deadline, "profiles": profiles,
            "profiles_complete": exit_code == 0 and profiles_nonempty,
            "error": error,
            "max_rss": resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss,
            "max_rss_units": "bytes" if sys.platform == "darwin" else "KiB",
        }
        (directory / "result.json").write_text(json.dumps(receipt, indent=2) + "\n")
    if error:
        print(f"ci-lint-profile: {error}", file=sys.stderr)
    return exit_code


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--deadline", required=True, type=float,
                        help="absolute time.monotonic deadline, captured before job setup")
    parser.add_argument("--profile-dir", required=True, type=Path)
    parser.add_argument("command", nargs=argparse.REMAINDER)
    args = parser.parse_args()
    command = args.command[1:] if args.command[:1] == ["--"] else args.command
    if not command or not math.isfinite(args.deadline):
        parser.error("a finite deadline and command are required")
    return run(command, args.deadline, args.profile_dir)


if __name__ == "__main__":
    if sys.argv[1:2] == ["--supervise"]:
        supervise(int(sys.argv[2]), sys.argv[3:])
    else:
        sys.exit(main())
