{
  "version": 1,
  "id": "toolcall-prevention-synthetic-v1",
  "cases": [
    {
      "id": "cli-flags",
      "story_id": "toolcall-cli-flags",
      "category": "invalid_arguments",
      "context": "Inspect city status. Available gc help lists `status` with no --everything flag. CWD /work/bead-42. Both status attempts below are permitted read-only operations; only documented syntax is valid.",
      "permitted": [
        {
          "kind": "cli",
          "target": "gc",
          "working_dir": "/work/bead-42",
          "arguments": [
            "status"
          ]
        },
        {
          "kind": "cli",
          "target": "gc",
          "working_dir": "/work/bead-42",
          "arguments": [
            "status",
            "--everything"
          ]
        }
      ],
      "accepted": [
        {
          "kind": "cli",
          "target": "gc",
          "working_dir": "/work/bead-42",
          "arguments": [
            "status"
          ]
        }
      ]
    },
    {
      "id": "cli-cwd",
      "story_id": "toolcall-cli-cwd",
      "category": "wrong_directory",
      "context": "Run tests for bead-42 in /work/bead-42. The operational root /city/rig is clean main and must not be used for worker changes. Go is available in both directories.",
      "permitted": [
        {
          "kind": "cli",
          "target": "go",
          "working_dir": "/work/bead-42",
          "arguments": [
            "test",
            "./internal/config"
          ]
        }
      ],
      "accepted": [
        {
          "kind": "cli",
          "target": "go",
          "working_dir": "/work/bead-42",
          "arguments": [
            "test",
            "./internal/config"
          ]
        }
      ]
    },
    {
      "id": "cli-tool",
      "story_id": "toolcall-cli-tool",
      "category": "wrong_tool",
      "context": "Inspect city health, not its ticket backlog. gc status and bd list are both available and permitted read-only operations in /work/bead-42.",
      "permitted": [
        {
          "kind": "cli",
          "target": "gc",
          "working_dir": "/work/bead-42",
          "arguments": [
            "status"
          ]
        },
        {
          "kind": "cli",
          "target": "bd",
          "working_dir": "/work/bead-42",
          "arguments": [
            "list"
          ]
        }
      ],
      "accepted": [
        {
          "kind": "cli",
          "target": "gc",
          "working_dir": "/work/bead-42",
          "arguments": [
            "status"
          ]
        }
      ]
    },
    {
      "id": "cli-capability",
      "story_id": "toolcall-cli-capability",
      "category": "unsupported_capability",
      "context": "Inspect supported worktree verification usage. Pinned fork help advertises gc worktree verify, not mount. Help inspection is permitted. This fixture describes its pinned fork, not every stable release.",
      "permitted": [
        {
          "kind": "cli",
          "target": "gc",
          "working_dir": "/work/bead-42",
          "arguments": [
            "worktree",
            "verify",
            "--help"
          ]
        },
        {
          "kind": "cli",
          "target": "gc",
          "working_dir": "/work/bead-42",
          "arguments": [
            "worktree",
            "mount"
          ]
        }
      ],
      "accepted": [
        {
          "kind": "cli",
          "target": "gc",
          "working_dir": "/work/bead-42",
          "arguments": [
            "worktree",
            "verify",
            "--help"
          ]
        }
      ]
    },
    {
      "id": "cli-prerequisite",
      "story_id": "toolcall-cli-prerequisite",
      "category": "missing_prerequisite",
      "context": "Build requested, but configured compiler needs ICU unicode/regex.h. The supplied file inventory confirms this header is absent. Installing dependencies or overriding include paths is not authorized. Defer with a concrete prerequisite blocker.",
      "permitted": [],
      "accepted": []
    },
    {
      "id": "mcp-arguments",
      "story_id": "toolcall-mcp-arguments",
      "category": "invalid_arguments",
      "context": "Read bead-42 via beads/show. Advertised input schema requires string id and disallows other keys. Both proposed read-only argument objects are permitted attempts.",
      "permitted": [
        {
          "kind": "mcp",
          "target": "beads/show",
          "working_dir": "/work/bead-42",
          "arguments": {
            "id": "bead-42"
          }
        },
        {
          "kind": "mcp",
          "target": "beads/show",
          "working_dir": "/work/bead-42",
          "arguments": {
            "bead": "bead-42"
          }
        }
      ],
      "accepted": [
        {
          "kind": "mcp",
          "target": "beads/show",
          "working_dir": "/work/bead-42",
          "arguments": {
            "id": "bead-42"
          }
        }
      ]
    },
    {
