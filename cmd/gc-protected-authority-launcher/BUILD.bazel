load("@rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "gc-protected-authority-launcher_lib",
    srcs = [
        "main_linux.go",
        "main_other.go",
    ],
    importpath = "github.com/gastownhall/gascity/cmd/gc-protected-authority-launcher",
    visibility = ["//visibility:private"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//internal/beadspermitbroker",
        ],
        "@rules_go//go/platform:linux": [
            "//internal/beadspermitbroker",
        ],
        "//conditions:default": [],
    }),
)

go_binary(
    name = "gc-protected-authority-launcher",
    embed = [":gc-protected-authority-launcher_lib"],
    visibility = ["//visibility:public"],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)
