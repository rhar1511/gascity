sh -c 'target="$1"; ready_json=$(bd ready --metadata-field "gc.routed_to=$target" --unassigned --exclude-type=epic --exclude-label "hold:mayor" --exclude-label "hold:external" --json --limit 0) || exit $?; legacy_candidates=$(bd ready --metadata-field "gc.run_target=$target" --metadata-field "gc.kind=workflow" --unassigned --exclude-type=epic --exclude-label "hold:mayor" --exclude-label "hold:external" --json --sort oldest --limit 0) || exit $?; legacy_json=$(printf "%s" "$legacy_candidates" | jq '\''[.[] | select(((.metadata["gc.routed_to"] // "") == "") and ((.metadata["gc.workflow_expanded"] // "") != "true"))]'\'') || exit $?; legacy_ephemeral_json=$({ candidates=$(bd query --json '\''ephemeral=true AND status=open'\'' --limit=0) || { exit $?; }; fast_rows=$(printf "%s\n" "$candidates" | jq -c --arg target "$target" '\''[.[] | select((.assignee // "") == "") | select(((.metadata["gc.routed_to"] // "") == $target) or (((.metadata["gc.routed_to"] // "") == "") and ((.metadata["gc.run_target"] // "") == $target) and ((.metadata["gc.kind"] // "") == "workflow") and ((.metadata["gc.workflow_expanded"] // "") != "true"))) | select(((.issue_type // .type // "") != "epic")) | select(([ (.labels // [])[] | select(. == "hold:mayor" or . == "hold:external") ] | length) == 0) | select(((.dependency_count // 0) == 0))] | sort_by(.created_at // "", .id // "") | .[]'\'') || { exit $?; }; slow_candidates=$(printf "%s\n" "$candidates" | jq -c --arg target "$target" '\''[.[] | select((.assignee // "") == "") | select(((.metadata["gc.routed_to"] // "") == $target) or (((.metadata["gc.routed_to"] // "") == "") and ((.metadata["gc.run_target"] // "") == $target) and ((.metadata["gc.kind"] // "") == "workflow") and ((.metadata["gc.workflow_expanded"] // "") != "true"))) | select(((.issue_type // .type // "") != "epic")) | select(([ (.labels // [])[] | select(. == "hold:mayor" or . == "hold:external") ] | length) == 0) | select(((.dependency_count // 0) > 0))] | sort_by(.created_at // "", .id // "") | .[]'\'') || { exit $?; }; slow_rows=$(printf "%s\n" "$slow_candidates" | while IFS= read -r candidate; do id=$(printf "%s" "$candidate" | jq -r '\''.id // empty'\'') || { exit $?; }; [ -n "$id" ] || continue; detail=$(bd show "$id" --json) || { exit $?; }; nblocked=$(printf "%s" "$detail" | jq -er '\''[.[0].dependencies[]? | select(.dependency_type == "blocks" or .dependency_type == "waits-for" or .dependency_type == "conditional-blocks") | select(((.status // "") | ascii_downcase) != "closed")] | length'\'') || { exit $?; }; if [ "$nblocked" = "0" ]; then printf "%s\n" "$candidate"; fi; done) || { exit $?; }; printf "%s\n%s\n" "$fast_rows" "$slow_rows" | jq -s '\''sort_by(.created_at // "", .id // "")'\''; }) || exit $?; printf "%s\n%s\n%s\n" "$ready_json" "$legacy_json" "$legacy_ephemeral_json" | jq -s "(add // []) | unique_by(.id) | length"' -- rig/control-dispatcher