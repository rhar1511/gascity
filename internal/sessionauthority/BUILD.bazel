load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "sessionauthority",
    srcs = ["authority.go"],
    importpath = "github.com/gastownhall/gascity/internal/sessionauthority",
    visibility = ["//:__subpackages__"],
    deps = ["//internal/beadmeta"],
)

go_test(
    name = "sessionauthority_test",
    srcs = [
        "authority_test.go",
        "testenv_import_test.go",
    ],
    embed = [":sessionauthority"],
    deps = ["//internal/testenv"],
)

