load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "selectorinventory",
    srcs = [
        "external_ledger.go",
        "linux_filesystem_linux.go",
        "selectorinventory.go",
    ],
    importpath = "github.com/gastownhall/gascity/internal/selectorinventory",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/selectorattestation",
    ] + select({
        "@rules_go//go/platform:android": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:linux": [
            "@org_golang_x_sys//unix",
        ],
        "//conditions:default": [],
    }),
)

go_test(
    name = "selectorinventory_test",
    srcs = [
        "external_ledger_test.go",
        "linux_filesystem_test.go",
        "selectorinventory_test.go",
    ],
    embed = [":selectorinventory"],
    deps = [
        "//internal/selectorattestation",
    ] + select({
        "@rules_go//go/platform:android": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:linux": [
            "@org_golang_x_sys//unix",
        ],
        "//conditions:default": [],
    }),
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)
