load("@rules_go//go:def.bzl", "go_test")

filegroup(
    name = "suite",
    srcs = ["suite.json"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "suite_v2",
    srcs = ["suiteV2.json"],
    visibility = ["//visibility:public"],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---
filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)

go_test(
    name = "inktree-story-agency-v1_test",
    srcs = [
        "suite_test.go",
        "testenv_import_test.go",
    ],
    embedsrcs = [
        "baseline.example.json",
        "candidate.example.json",
        "suite.json",
        "suiteV2.json",
    ],
    deps = [
        "//internal/storybench",
        "//internal/testenv",
    ],
)
